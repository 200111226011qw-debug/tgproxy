# 复制本文件为同目录下的 keystore.properties 后按实际填写。
# keystore.properties 已被 .gitignore 忽略 —— 私钥与口令绝不要提交。
#
# 取值优先级：环境变量 > 本文件
#   TGPROXY_KEYSTORE          密钥文件绝对路径
#   TGPROXY_STORE_PASSWORD    仓库口令
#   TGPROXY_KEY_ALIAS         密钥别名
#   TGPROXY_KEY_PASSWORD      密钥口令
#
# 生成密钥（在终端里跑，口令由 keytool 交互式询问，不会留在命令历史里）：
#   "C:\Users\<你的用户名>\AppData\Local\tgproxy-build\jdk\jdk-17.0.20.1+1\bin\keytool.exe" -genkeypair -v ^
#     -keystore "C:\Users\<你的用户名>\.android\tgproxy-release.jks" ^
#     -storetype PKCS12 -keyalg RSA -keysize 4096 -validity 10000 ^
#     -alias tgproxy-release ^
#     -dname "CN=TGProxy, OU=Personal, O=kkf, C=CN"

# 密钥文件：绝对路径，放在仓库外
storeFile=C:/Users/<你的用户名>/.android/tgproxy-release.jks
# 仓库口令（keytool 生成时输入的那一个）
storePassword=
# 密钥别名
keyAlias=tgproxy-release
# 密钥口令（与仓库口令相同时可留空）
keyPassword=
