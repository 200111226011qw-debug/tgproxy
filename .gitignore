# 工作区与系统
.workbuddy/
.DS_Store
Thumbs.db
desktop.ini

# Python（桌面版运行时产物）
__pycache__/
*.pyc
config.json
known_good.json
known_bad.json
source_health.json
rounds.jsonl
tgproxy.log

# v2.2.1 起运行时状态统一放 tgproxy/data/（上面几条按文件名忽略，这里整目录兜底，
# 免得以后新增状态文件又漏掉一个）
tgproxy/data/

# 发行产物（dist/ 仅本地备料，不进仓库）
version-release-client/dist/

# Android / Gradle（安卓版构建产物）
.gradle/
build/
local.properties
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# PyInstaller（桌面版打包产物）
dist/
build/
# 历史版本的 exe 备份（换版时把旧产物挪到这里，避免和当前 dist/ 混在一起）
_archive/
# tgproxy/tgproxy.spec 已刻意入库（-f 强制添加），以保证从 tag 可重建 exe；
# 本行仅忽略将来新增的其他 spec
*.spec

# Android 签名材料：私钥与口令绝不能进仓库
*.jks
*.keystore
keystore.properties

# Kotlin 2.x 构建缓存
.kotlin/
